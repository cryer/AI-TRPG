{
  "sample_rate": 16000,
  "frame_ms": 32,
  "endpoint_ms": 400,
  "final_grace_ms": 150,
  "asr_catchup_ms": 400,
  "bargein_confirm_ms": 200,
  "budget_ms": {
    "vad_endpoint": 400,
    "asr_final": 150,
    "llm_first_sentence": 400,
    "tts_first_chunk": 200,
    "transport_buffer": 50,
    "total": 1200,
    "telephony_total": 1600
  },
  "vad": {
    "model_path": "../realtime-voice-agent/models/silero_vad.onnx",
    "threshold": 0.5,
    "neg_threshold": 0.35,
    "min_speech_ms": 96
  },
  "providers": {
    "asr": "sherpa",
    "llm": "kimi",
    "tts": "cosyvoice"
  },
  "sherpa_asr": {
    "model_dir": "../realtime-voice-agent/models/sherpa-asr-bilingual-zh-en",
    "provider": "cpu",
    "num_threads": 4
  },
  "sherpa_tts": {
    "model_dir": "../realtime-voice-agent/models/vits-zh-hf-fanchen-C",
    "provider": "cpu",
    "num_threads": 4,
    "speed": 1.1
  },
  "cosyvoice": {
    "repo_path": "vendor/CosyVoice",
    "model_dir": "./models/CosyVoice2-0.5B",
    "default_voice": "narrator_m",
    "fp16": true,
    "use_ort_estimator": true,
    "nfe": 5,
    "cudnn_benchmark": false,
    "voices": {
      "narrator_m": {
        "prompt_wav": "./models/voices/narrator_m.wav",
        "instruct": "用低沉平稳、富有叙事感的语气讲述"
      },
      "npc_female": {
        "prompt_wav": "./models/voices/npc_female.wav",
        "instruct": "用冷静优雅的语气说话"
      },
      "npc_female_young": {
        "prompt_wav": "./models/voices/npc_female_young.wav",
        "instruct": "用清亮自然的语气说话"
      },
      "npc_male_old": {
        "prompt_wav": "./models/voices/npc_male_old.wav",
        "instruct": "用苍老缓慢的语气说话"
      },
      "npc_male_young": {
        "prompt_wav": "./models/voices/npc_male_young.wav",
        "instruct": "用沉稳的青年语气说话"
      }
    }
  },
  "kimi": {
    "model": "kimi-for-coding-highspeed",
    "reasoning_effort": "low",
    "max_tokens": 800
  },
  "volcengine_asr": {
    "resource_id": "volc.seedasr.sauc.duration"
  },
  "volcengine": {
    "speaker": "zh_female_vv_uranus_bigtts",
    "resource_id": "seed-tts-2.0"
  },
  "game": {
    "adventures_dir": "adventures",
    "window_turns": 18,
    "summary_interval_turns": 15,
    "bargein_narration_ms": 500,
    "bargein_listen_ms": 200
  }
}
