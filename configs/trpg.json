{
  "sample_rate": 16000,
  "frame_ms": 32,
  "endpoint_ms": 400,
  "final_grace_ms": 150,
  "asr_catchup_ms": 400,
  "bargein_confirm_ms": 200,
  "budget_ms": {
    "vad_endpoint": 400,
    "asr_final": 150,
    "llm_first_sentence": 400,
    "tts_first_chunk": 200,
    "transport_buffer": 50,
    "total": 1200,
    "telephony_total": 1600
  },
  "vad": {
    "model_path": "models/silero_vad.onnx",
    "threshold": 0.5,
    "neg_threshold": 0.35,
    "min_speech_ms": 96
  },
  "providers": {
    "asr": "sherpa",
    "llm": "kimi",
    "tts": "cosyvoice"
  },
  "sherpa_asr": {
    "model_dir": "models/sherpa-asr-bilingual-zh-en",
    "provider": "cpu",
    "num_threads": 4
  },
  "sherpa_tts": {
    "model_dir": "models/vits-zh-hf-fanchen-C",
    "provider": "cpu",
    "num_threads": 4,
    "speed": 1.1
  },
  "cosyvoice": {
    "_readme": "本地 TTS 调优指南（参数/声线/情绪怎么改）见 docs/local-tts.md",
    "repo_path": "vendor/CosyVoice",
    "model_dir": "models/CosyVoice2-0.5B",
    "default_voice": "narrator_m",
    "fp16": true,
    "use_ort_estimator": true,
    "nfe": 3,
    "cudnn_benchmark": false,
    "speed": 1.0,
    "merge_max_chars": 150,
    "merge_wait_s": 0.05,
    "emotions": ["平静", "紧张", "恐惧", "愤怒", "悲伤", "神秘",
                 "激动", "低语", "恭敬", "犹豫", "温柔", "威严"],
    "voices": {
      "narrator_m": {
        "prompt_wav": "models/voices/narrator_m.wav",
        "instruct": "用低沉平稳、富有叙事感的语气讲述"
      },
      "npc_female": {
        "prompt_wav": "models/voices/npc_female.wav",
        "instruct": "用冷静优雅的语气说话"
      },
      "npc_female_young": {
        "prompt_wav": "models/voices/npc_female_young.wav",
        "instruct": "用清亮自然的语气说话"
      },
      "npc_male_old": {
        "prompt_wav": "models/voices/npc_male_old.wav",
        "instruct": "用苍老缓慢的语气说话"
      },
      "npc_male_young": {
        "prompt_wav": "models/voices/npc_male_young.wav",
        "instruct": "用沉稳的青年语气说话"
      }
    }
  },
  "kimi": {
    "model": "kimi-for-coding-highspeed",
    "reasoning_effort": "low",
    "max_tokens": 800
