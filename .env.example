# ai-TRPG 环境变量（复制为 .env 后填写；.env 已 gitignore，绝不提交真实 key）

# 必需：LLM。Kimi（Moonshot）API key
# 申请：https://platform.moonshot.cn/ （或 Kimi coding 订阅走 api.kimi.com）
KIMI_API_KEY=

# 火山引擎语音服务（云端 ASR/TTS 必需；本地 TTS 的声线参考音生成脚本也用它）
# 申请：console.volcengine.com → 语音技术 → 开通「语音识别」「语音合成」→ 创建 API Key
VOLCENGINE_API_KEY=

# 可选：Deepgram ASR（备选云端识别，默认配置不使用）
# DEEPGRAM_API_KEY=
