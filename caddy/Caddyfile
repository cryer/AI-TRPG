{
    auto_https disable_redirects
}

# sslip.io 泛域名用法：把服务器公网 IP 的点换成连字符，任意 *.<IP-连字符>.sslip.io
# 都解析到该 IP。例如 IP 为 203.0.113.10 时，域名是 203-0-113-10.sslip.io。
# Caddy + ACME TLS-ALPN 签发证书，需 443 对公网可达。
# 注意：443 全机只能有一个监听者；若同机还有其他 caddy 实例在跑，
# 请把多个域名合并到同一个 caddy 实例，不要同时起两个。
# 部署时把下面的 <YOUR-SERVER-IP-DASHED> 替换为实际 IP 的连字符形式。
trpg.<YOUR-SERVER-IP-DASHED>.sslip.io {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    reverse_proxy 127.0.0.1:16891
}
